    {
      "name": "01 - Blog Posts",
      "item": [
        {
          "name": "Create Post (multipart + post JSON) [auth]",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const slug = `sustainable-travel-${Date.now()}`;",
                  "pm.collectionVariables.set('slug', slug);",
                  "const post = {",
                  "  title: 'Sustainable Travel Guide 2026',",
                  "  content: 'Legacy content (required)',",
                  "  slug,",
                  "  excerpt: 'Learn how to travel responsibly with eco-friendly tips.',",
                  "  readingTime: 5,",
                  "  featuredImage: { url: '', alt: 'Snow mountains travel', caption: 'Exploring nature responsibly' },",
                  "  categories: ['Travel Tips', 'Responsible Travel'],",
                  "  tags: ['Sustainable Travel', 'Eco Tourism', 'Travel Guide'],",
                  "  tableOfContents: [",
                  "    { title: 'Sustainable Travel', slug: 'sustainable-travel' },",
                  "    { title: 'Eco-Friendly Travel Tips', slug: 'eco-friendly-travel-tips' }",
                  "  ],",
                  "  contentBlocks: [",
                  "    {",
                  "      id: 'block-1',",
                  "      type: 'imageBulletSection',",
                  "      title: 'Sustainable Travel',",
                  "      image: { url: '', alt: 'Mountain travel view', caption: 'Travel' },",
                  "      description: 'Sustainable travel focuses on protecting the environment, supporting local communities, and preserving cultural heritage while exploring new destinations.',",
                  "      bullets: [",
                  "        'Choose eco-friendly accommodations',",
                  "        'Reduce plastic waste during travel',",
                  "        'Respect local cultures and traditions',",
                  "        'Support local businesses and communities'",
                  "      ]",
                  "    },",
                  "    {",
                  "      id: 'block-2',",
                  "      type: 'imageBulletSection',",
                  "      title: 'Eco-Friendly Travel Tips',",
                  "      image: { url: '', alt: 'Eco friendly travel city', caption: 'Eco-Friendly Travel' },",
                  "      description: 'Small travel habits can make a big impact on the planet. Following eco-friendly practices helps reduce environmental impact.',",
                  "      bullets: [",
                  "        'Carry reusable water bottles',",
                  "        'Avoid single-use plastic products',",
                  "        'Use trains or public transport',",
                  "        'Travel slow and explore fewer destinations',",
                  "        'Participate in eco-tourism activities'",
                  "      ]",
                  "    }",
                  "  ],",
                  "  travelMeta: {",
                  "    destination: 'Global',",
                  "    country: 'Multiple',",
                  "    state: '',",
                  "    city: '',",
                  "    bestSeason: 'Year Round',",
                  "    budgetRange: 'Medium',",
                  "    travelType: ['Eco Travel', 'Nature', 'Responsible Tourism'],",
                  "    idealDuration: '3-7 Days',",
                  "    difficulty: 'Easy',",
                  "    familyFriendly: true",
                  "  },",
                  "  seo: {",
                  "    metaTitle: 'Sustainable Travel Guide 2026 | Eco Friendly Tourism Tips',",
                  "    metaDescription: 'Discover eco-friendly travel tips and learn how to explore the world responsibly with sustainable tourism practices.',",
                  "    keywords: ['Sustainable Travel', 'Eco Friendly Tourism', 'Responsible Travel', 'Green Travel Tips']",
                  "  },",
                  "  visibility: 'PUBLIC',",
                  "  language: 'en',",
                  "  isFeatured: true,",
                  "  isTrending: false,",
                  "  allowComments: true,",
                  "  allowLikes: true,",
                  "  postType: 'BLOG'",
                  "};",
                  "pm.collectionVariables.set('postJson', JSON.stringify(post));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const json = pm.response.json();",
                  "  if (json && json.data && json.data.id) {",
                  "    pm.collectionVariables.set('postId', json.data.id);",
                  "    if (json.data.slug) pm.collectionVariables.set('slug', json.data.slug);",
                  "    if (json.data.media && json.data.media.length && json.data.media[0].id) pm.collectionVariables.set('mediaId', json.data.media[0].id);",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "{{gatewayHeaderName}}", "value": "{{gatewayHeaderValue}}" },
              { "key": "{{authenticatedHeader}}", "value": "true" },
              { "key": "{{userIdHeader}}", "value": "{{userId}}" },
              { "key": "{{userEmailHeader}}", "value": "{{userEmail}}" },
              { "key": "{{userRoleHeader}}", "value": "{{userRole}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "post",
                  "type": "text",
                  "contentType": "application/json",
                  "value": "{{postJson}}"
                },
                {
                  "key": "mediaFiles",
                  "type": "file",
                  "src": "{{mediaFile1}}"
                },
                {
                  "key": "mediaFiles",
                  "type": "file",
                  "src": "{{mediaFile2}}"
                },
                {
                  "key": "mediaFiles",
                  "type": "file",
                  "src": "{{mediaFile3}}"
                },
                { "key": "mediaCaptions", "type": "text", "value": "cover" },
                { "key": "mediaCaptions", "type": "text", "value": "Sustainable Travel" },
                { "key": "mediaCaptions", "type": "text", "value": "Eco-Friendly Travel Tips" },
                { "key": "mediaDescriptions", "type": "text", "value": "Featured cover image" },
                { "key": "mediaDescriptions", "type": "text", "value": "Block 1 image" },
                { "key": "mediaDescriptions", "type": "text", "value": "Block 2 image" },
                { "key": "mediaSubtitles", "type": "text", "value": "cover" },
                { "key": "mediaSubtitles", "type": "text", "value": "Sustainable Travel" },
                { "key": "mediaSubtitles", "type": "text", "value": "Eco-Friendly Travel Tips" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/v1/blog/posts/create", "host": ["{{baseUrl}}"], "path": ["api", "v1", "blog", "posts", "create"] }
          }
