# ============================================
# customer-support-service - Environment Variables
# ============================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to git!

# ====================
# Database Configuration
# ====================
DATABASE_URL=jdbc:postgresql://localhost:5432/customer-support-service_db
DB_USERNAME=admin
DB_PASSWORD=your-strong-database-password-here

# ====================
# Redis Configuration
# ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-strong-redis-password-here

# ====================
# AWS S3 Configuration
# ====================
AWS_ACCESS_KEY=your-aws-access-key-here
AWS_SECRET_KEY=your-aws-secret-key-here
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name

# ====================
# JWT Configuration
# ====================
JWT_SECRET_KEY=your-jwt-secret-key-min-32-characters-here

# ====================
# Email Configuration
# ====================
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-email-password-or-app-password

# ====================
# Twilio Configuration
# ====================
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here

# ====================
# Server Configuration
# ====================
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=dev
