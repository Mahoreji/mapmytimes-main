{
	"info": {
		"_postman_id": "7b4be104-d2e1-45f8-b493-271d68ab3292",
		"name": "MapMyTour - API Gateway PRO",
		"description": "Enterprise-grade Postman collection for the MapMyTour API Gateway. Features full security administrative suite, real-time telemetry, and exhaustive microservice route mapping for the entire MapMyTour ecosystem.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "🛡️ Security Administration",
			"description": "Native gateway endpoints for managing IP whitelists, manual bans, and behavioral threat scoring. \n\nIMPORTANT: Whitelisting operations strictly require the SUPER_ADMIN role.",
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{admin_token}}",
						"type": "string"
					}
				]
			},
			"item": [
				{
					"name": "IP Whitelisting",
					"item": [
						{
							"name": "List All Whitelisted IPs",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{baseUrl}}/api/v1/admin/security/ip-whitelist",
									"host": ["{{baseUrl}}"],
									"path": ["api", "v1", "admin", "security", "ip-whitelist"]
								},
								"description": "Retrieves the full list of active whitelisted IP addresses. Requires ADMIN or SUPER_ADMIN role. Alias: /whitelist/all"
							}
						},
						{
							"name": "Add IP to Whitelist",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"ip\": \"122.161.50.44\",\n    \"remarks\": \"Office Static IP\",\n    \"ttlDays\": 30\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/api/v1/admin/security/whitelist",
									"host": ["{{baseUrl}}"],
									"path": ["api", "v1", "admin", "security", "whitelist"]
								},
								"description": "Whitelists an IP address for admin access. STRICTLY REQUIRES SUPER_ADMIN ROLE. Set ttlDays to -1 for a permanent entry with no expiry."
							}
						},
						{
							"name": "Check IP Status",
							"request": {
								"method": "GET",
								"url": {
									"raw": "{{baseUrl}}/api/v1/admin/security/whitelist/122.161.50.44",
									"host": ["{{baseUrl}}"],
									"path": ["api", "v1", "admin", "security", "whitelist", "122.161.50.44"]
								},
								"description": "Verifies if the specified IP address is currently whitelisted for admin access."
							}
						},
						{
							"name": "Whitelist My IP (Self)",
							"request": {
								"method": "POST",
								"url": {
									"raw": "{{baseUrl}}/api/v1/admin/security/whitelist/me?ttlDays=30",
									"host": ["{{baseUrl}}"],
									"path": ["api", "v1", "admin", "security", "whitelist", "me"],
									"query": [
										{
											"key": "ttlDays",
											"value": "30"
										}
									]
								},
								"description": "Convenience method to whitelist the current requester's IP (Bootstrap helper). STRICTLY REQUIRES SUPER_ADMIN JWT TOKEN."
							}
						},
						{
							"name": "Remove IP from Whitelist",
							"request": {
								"method": "DELETE",
								"url": {
									"raw": "{{baseUrl}}/api/v1/admin/security/whitelist/122.161.50.44",
									"host": ["{{baseUrl}}"],
									"path": ["api", "v1", "admin", "security", "whitelist", "122.161.50.44"]
								},
								"description": "Immediately revokes admin access for the specified IP address. STRICTLY REQUIRES SUPER_ADMIN ROLE."
							}
						}
					]
				},
				{
					"name": "Ban & Suspensions",
					"item": [
						{
							"name": "Manual IP Ban",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"ip\": \"203.0.113.42\",\n    \"reason\": \"Suspicious pattern detected\",\n    \"expiryMinutes\": 1440\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/api/v1/admin/security/bans",
									"host": ["{{baseUrl}}"],
									"path": ["api", "v1", "admin", "security", "bans"]
								},
								"description": "Suspends all access for a specific IP address. Requires ADMIN role."
							}
						},
						{
							"name": "Lift IP Ban (Unban)",
							"request": {
								"method": "DELETE",
								"url": {
									"raw": "{{baseUrl}}/api/v1/admin/security/bans/203.0.113.42",
									"host": ["{{baseUrl}}"],
									"path": ["api", "v1", "admin", "security", "bans", "203.0.113.42"]
								},
								"description": "Clears any detected or manual ban for the specified IP address. Requires ADMIN role."
							}
						}
					]
				},
				{
					"name": "Threat Auditing",
					"item": [
						{
							"name": "Audit All Threat Scores",
							"request": {
								"method": "GET",
								"url": {
									"raw": "{{baseUrl}}/api/v1/admin/security/threat-scores",
									"host": ["{{baseUrl}}"],
									"path": ["api", "v1", "admin", "security", "threat-scores"]
								},
								"description": "Lists all active behavioral threat scores in Redis. Requires ADMIN role."
							}
						},
						{
							"name": "Get Multi-Layer Threat Score",
							"request": {
								"method": "GET",
								"url": {
									"raw": "{{baseUrl}}/api/v1/admin/security/threat-score/203.0.113.42",
									"host": ["{{baseUrl}}"],
									"path": ["api", "v1", "admin", "security", "threat-score", "203.0.113.42"]
								},
								"description": "Retrieves the rolling behavioral threat score for any IP. Requires ADMIN role."
							}
						}
					]
				}
			]
		},
		{
			"name": "📊 Monitoring & Health",
			"item": [
				{
					"name": "Security Telemetry Stats",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/security/telemetry/stats",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "admin", "security", "telemetry", "stats"]
						},
						"description": "Real-time stats on security events and blocks. Requires ADMIN role."
					}
				},
				{
					"name": "Actuator Health Hub",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/actuator/health",
							"host": ["{{baseUrl}}"],
							"path": ["actuator", "health"]
						},
						"description": "Standard Spring Boot Actuator health endpoint."
					}
				}
			]
		},
