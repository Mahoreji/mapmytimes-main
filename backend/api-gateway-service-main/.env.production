# ============================================================================
# MapMyTour API Gateway - Production Environment Configuration (Docker)
# ============================================================================
# This file is configured for Docker Compose production deployment.
# When using docker-compose.yml, these values may be overridden by docker-compose.yml
# environment variables, which take precedence.
# ============================================================================

# ==================== SERVER CONFIGURATION ====================
SERVER_PORT=8080
SPRING_APPLICATION_NAME=mapmytour-api-gateway
SPRING_PROFILES_ACTIVE=prod

# ==================== SERVICE URLs (Docker Service Names) ====================
# IMPORTANT: These use Docker service names for internal Docker network communication
# When running with docker-compose.yml, these match the service names in docker-compose.yml

# Auth & User Service (Combined)
# Note: application.yml uses AUTH_SERVICE_URL (not AUTH_USER_SERVICE_URL)
AUTH_SERVICE_URL=http://auth-service:8081
AUTH_USER_SERVICE_URL=http://auth-service:8081  # Alias for backward compatibility

# Payment Service
PAYMENT_SERVICE_URL=http://payment-service:8088

# Booking Service
BOOKING_SERVICE_URL=http://booking-service:8089

# Travel Service
TRAVEL_SERVICE_URL=http://travel-service:8085

# Reviews Service
REVIEWS_SERVICE_URL=http://review-service:8087

# Blog Service
BLOG_SERVICE_URL=http://blog-service:8090

# Customer Support Service
CUSTOMER_SUPPORT_SERVICE_URL=http://customer-service:8086

# Utils Service
UTILS_SERVICE_URL=http://utils-service:8082

# Core Service (Tours, Destinations, Activities, Adventures)
CORE_SERVICE_URL=http://core-service:8083

# Chat/AI Service
CHAT_SERVICE_URL=http://chat-service:8084

# Hotel Service
HOTEL_SERVICE_URL=http://hotel-service:8092

# Notification Service
NOTIFICATION_SERVICE_URL=http://notification-service:9090

# Additional Services (CRM/ERP)
AGENT_SERVICE_URL=http://agent-service:8103
LEAD_SERVICE_URL=http://lead-service:8100
SUPPLIER_SERVICE_URL=http://supplier-service:8093
EMPLOYEE_SERVICE_URL=http://employee-service:8094
DOCUMENT_SERVICE_URL=http://document-service:8095
GST_SERVICE_URL=http://accounting-gst-service:8098
FRAUD_SERVICE_URL=http://fraud-detection-service:8099
AUDIT_SERVICE_URL=http://audit-log-service:8100
REPORT_SERVICE_URL=http://report-analytics-service:8101
GROUP_BOOKING_SERVICE_URL=http://group-booking-service:8102
CORPORATE_TRAVEL_SERVICE_URL=http://corporate-travel-service:8103

# ==================== JWT CONFIGURATION ====================
# IMPORTANT: Change this in production! Use a strong, unique secret key
JWT_SECRET=mapMyTourProductionSecretKey885839!VerySecureAndLongEnoughForHS256AlgorithmRequirement123456789
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ==================== REDIS CONFIGURATION ====================
# Production Redis Configuration
REDIS_HOST=150.241.245.162
REDIS_PORT=6379
REDIS_PASSWORD=MapMyTour@ProdRedis885839!SuperSecure
REDIS_DATABASE=0
REDIS_TIMEOUT=2000ms

# ==================== RATE LIMITING CONFIGURATION ====================
# Enable Rate Limiting for Production
RATE_LIMIT_ENABLED=true

# Rate Limits (requests per minute)
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=50
RATE_LIMIT_PAYMENT=30
RATE_LIMIT_BOOKING=60
RATE_LIMIT_CHAT=20
RATE_LIMIT_ADMIN=200
RATE_LIMIT_PUBLIC=150

# ==================== EUREKA CONFIGURATION ====================
# Service Discovery (disabled for Docker networking)
EUREKA_CLIENT_ENABLED=false
EUREKA_SERVICE_URL=http://localhost:8761/eureka

# ==================== CORS CONFIGURATION ====================
# Production Allowed Origins
CORS_ALLOWED_ORIGINS=https://mapmytour.in,https://www.mapmytour.in,https://api.mapmytour.in

# ==================== CIRCUIT BREAKER CONFIGURATION ====================
# Global Circuit Breaker Settings
CB_FAILURE_RATE_THRESHOLD=50
CB_SLOW_CALL_RATE_THRESHOLD=50
CB_SLOW_CALL_DURATION_THRESHOLD=2s
CB_WAIT_DURATION_IN_OPEN_STATE=5s
CB_SLIDING_WINDOW_SIZE=10
CB_MINIMUM_NUMBER_OF_CALLS=5

# Service-specific Circuit Breaker Timeouts (Production optimized)
CB_AUTH_TIMEOUT=60s
CB_PAYMENT_TIMEOUT=30s  # Increased for Cashfree API calls
CB_BOOKING_TIMEOUT=15s
CB_TRAVEL_TIMEOUT=600s
CB_REVIEWS_TIMEOUT=10s
CB_BLOG_TIMEOUT=300s  # Increased for file uploads
CB_SUPPORT_TIMEOUT=10s
CB_UTILS_TIMEOUT=10s
CB_CORE_TIMEOUT=120s  # Increased for multipart file uploads
CB_CHAT_TIMEOUT=100s
CB_NOTIFICATION_TIMEOUT=10s

# ==================== GATEWAY HTTP CLIENT CONFIGURATION ====================
# HTTP Client Timeouts (Production optimized)
GATEWAY_CONNECT_TIMEOUT=5000
GATEWAY_RESPONSE_TIMEOUT=30s  # Increased for payment service Cashfree API calls
GATEWAY_MAX_HEADER_SIZE=65536

# ==================== LOGGING CONFIGURATION ====================
# Production Log Levels
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_GATEWAY=INFO
LOG_LEVEL_MAPMYTOUR=INFO
LOG_LEVEL_RESILIENCE4J=INFO

# ==================== MONITORING CONFIGURATION ====================
# Management Endpoints
MANAGEMENT_ENDPOINTS_ENABLED=true
MANAGEMENT_HEALTH_SHOW_DETAILS=always
MANAGEMENT_METRICS_PROMETHEUS_ENABLED=true

# ==================== ENVIRONMENT INDICATORS ====================
ENVIRONMENT=Production
VERSION=2.0.0
BUILD_NUMBER=prod-build
