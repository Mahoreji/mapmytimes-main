{
	"info": {
		"_postman_id": "c1f7a08b-6a98-4d5c-bf77-987625db1c3f",
		"name": "MapMyTour Notification API Refactor",
		"description": "Collection for the refactored, production-ready travel booking Notification API. Includes support for paginated history, category/type/read filtering, dynamic actions, brand metadata, and read-tracking endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Core Notifications",
			"item": [
				{
					"name": "Trigger Instant PAYMENT_SUCCESS Notification",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"type\": \"PAYMENT_SUCCESS\",\n  \"recipient\": \"user_test_88@example.com\",\n  \"subject\": \"Payment Completed\",\n  \"body\": \"Processing Payment\",\n  \"metadata\": {\n    \"bookingId\": \"mapmytour-8821\",\n    \"bookingType\": \"FLIGHT\",\n    \"serviceName\": \"Mumbai → Dubai Flight\",\n    \"from\": \"Mumbai\",\n    \"to\": \"Dubai\",\n    \"source\": \"Mumbai\",\n    \"destination\": \"Dubai\",\n    \"travelDate\": \"2026-06-15\",\n    \"paymentId\": \"pay_8829\",\n    \"amount\": \"22893.80\",\n    \"currency\": \"₹\",\n    \"paymentMethod\": \"UPI\",\n    \"paymentStatus\": \"SUCCESS\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/notification/send/instant",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"notification",
								"send",
								"instant"
							]
						},
						"description": "Triggers an instant payment success notification. Returns standard response with dynamic localized formatting and custom branding."
					},
					"response": []
				},
				{
					"name": "Trigger Instant BOOKING_CONFIRMED Notification",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"type\": \"BOOKING_CONFIRMED\",\n  \"recipient\": \"user_test_88@example.com\",\n  \"subject\": \"Booking Completed\",\n  \"body\": \"Processing Booking\",\n  \"metadata\": {\n    \"bookingId\": \"mapmytour-hotel-99\",\n    \"bookingType\": \"HOTEL\",\n    \"serviceName\": \"Grand Hyatt Dubai\",\n    \"hotelName\": \"Grand Hyatt Dubai\",\n    \"checkInDate\": \"2026-06-15\",\n    \"checkOutDate\": \"2026-06-20\",\n    \"roomCount\": \"2\",\n    \"bookingStatus\": \"CONFIRMED\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/notification/send/instant",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"notification",
								"send",
								"instant"
							]
						},
						"description": "Triggers an instant hotel booking confirmation notification, dynamically building hotel-specific summary attributes."
					},
					"response": []
				},
				{
					"name": "Queue Standard Async Notification",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"type\": \"VOUCHER_READY\",\n  \"recipient\": \"user_test_88@example.com\",\n  \"subject\": \"Voucher Downloads Available\",\n  \"body\": \"Your voucher is ready\",\n  \"metadata\": {\n    \"bookingId\": \"mapmytour-8821\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/notification/send",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"notification",
								"send"
							]
						},
						"description": "Queues a standard notification asynchronously into the background Redis/Asynq delivery worker."
					},
					"response": []
				}
			]
		},
		{
			"name": "History & Query APIs",
			"item": [
				{
					"name": "Get Notification History (Filtered & Paginated)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/notifications?recipient=user_test_88@example.com&page=1&limit=10&category=PAYMENT",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"notifications"
							],
							"query": [
								{
									"key": "recipient",
									"value": "user_test_88@example.com",
									"description": "Target user recipient (email or userId)"
								},
								{
									"key": "page",
									"value": "1",
									"description": "Page offset index (defaults to 1)"
								},
								{
									"key": "limit",
									"value": "10",
									"description": "Max count per page limit (defaults to 20)"
								},
								{
									"key": "category",
									"value": "PAYMENT",
									"description": "Optional category filter (PAYMENT, BOOKING, VOUCHER, CANCELLATION, REFUND, SYSTEM)"
								},
								{
									"key": "type",
									"value": "PAYMENT_SUCCESS",
									"disabled": true,
									"description": "Optional specific event type filter"
								},
								{
									"key": "read",
									"value": "false",
									"disabled": true,
									"description": "Optional boolean read filter (true / false)"
								}
							]
						},
						"description": "Retrieves the rich, fully enriched notification DTO history list. Bookings and payments are resolved concurrently for maximum speed."
					},
					"response": []
				},
				{
					"name": "Get Unread Notifications Count",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/notifications/unread-count?recipient=user_test_88@example.com",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"notifications",
								"unread-count"
							],
							"query": [
								{
									"key": "recipient",
									"value": "user_test_88@example.com",
									"description": "Target recipient or userId"
								}
							]
						},
						"description": "Retrieves the current total count of unread notifications active for the given user."
					},
					"response": []
				}
			]
		},
		{
			"name": "Read State Operations",
			"item": [
				{
					"name": "Mark Specific Notification as Read",
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{base_url}}/notifications/:id/read",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"notifications",
								":id",
								"read"
							],
							"variable": [
								{
									"key": "id",
									"value": "4f5147d6-8cd8-4800-a90b-7955799399e8",
									"description": "Unique notification UUID"
								}
							]
						},
						"description": "Updates a single notification status to read and logs the exact read_at timestamp in the database."
					},
					"response": []
				},
				{
					"name": "Mark All Notifications as Read",
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{base_url}}/notifications/read-all?recipient=user_test_88@example.com",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"notifications",
								"read-all"
							],
							"query": [
								{
									"key": "recipient",
									"value": "user_test_88@example.com",
									"description": "Target recipient or userId"
								}
							]
						},
						"description": "Marks all unread notifications for a specific user as read concurrently."
					},
					"response": []
				}
			]
		},
		{
			"name": "Clear & Delete Operations",
			"item": [
				{
					"name": "Delete Specific Notification",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/notifications/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"notifications",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "4f5147d6-8cd8-4800-a90b-7955799399e8",
									"description": "Unique notification UUID to be permanently deleted"
								}
							]
						},
						"description": "Deletes/clears a specific notification completely by ID."
					},
					"response": []
				},
				{
					"name": "Delete All Notifications for Recipient",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/notifications?recipient=user_test_88@example.com",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"notifications"
							],
							"query": [
								{
									"key": "recipient",
									"value": "user_test_88@example.com",
									"description": "Target recipient or userId whose notifications are to be cleared"
								}
							]
						},
						"description": "Deletes/clears all notifications belonging to the specified recipient/userId."
					},
					"response": []
				}
			]
		}
	],
