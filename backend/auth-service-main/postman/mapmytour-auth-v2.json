        {
            "name": "4. OAuth2 (Social Login)",
            "item": [
                {
                    "name": "Initiate Google Login",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/oauth2/authorize/google?redirectUri=https://web.mapmytimes.com",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "oauth2",
                                "authorize",
                                "google"
                            ],
                            "query": [
                                {
                                    "key": "redirectUri",
                                    "value": "https://web.mapmytimes.com"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "OAuth2 Callback (Manual)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/oauth2/callback",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "oauth2",
                                "callback"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"provider\": \"google\",\n    \"idToken\": \"JWT_FROM_GOOGLE\",\n    \"accessToken\": \"ACCESS_TOKEN_FROM_GOOGLE\"\n}"
                        }
                    }
                }
            ]
        },
