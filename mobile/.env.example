# -----------------------------------------------------------------
# MapMyTimes Mobile App — Environment variables (DON'T commit real secrets here!)
# Usage: `cp .env.example .env` and fill with your real values.
# Envied generator reads this (see lib/core/env.dart.
# -----------------------------------------------------------------

APP_NAME=MapMyTimes
APP_ENV=dev

# Site config (same patterns as frontend SITE env vars)
SITE_NAME=MapMyTimes
SITE_URL=https://mapmytimes.com
SITE_CONTACT_EMAIL=admin@mapmytimes.com
SITE_CONTACT_PHONE=+91 9893989395

# Blog / Auth service API base (same as NEXT_PUBLIC_API_BASE_URL in frontend)
API_BASE_URL=https://api.mapmytimes.com

# Socials — open in browser
SOCIAL_FACEBOOK=https://facebook.com/mapmytimes
SOCIAL_TWITTER=https://x.com/mapmytimes
SOCIAL_INSTAGRAM=https://instagram.com/mapmytimes
SOCIAL_YOUTUBE=https://youtube.com/@mapmytimes
SOCIAL_LINKEDIN=https://linkedin.com/company/mapmytimes

# OAuth providers (app-level) — for flutter_web_auth_2 — fill from auth-service callback URL
AUTH_BASE_URL=https://api.mapmytimes.com
GOOGLE_CLIENT_ID=
FACEBOOK_CLIENT_ID=

# Deep linking for Android/iOS redirect scheme
APP_LINK_SCHEME=mapmytimes
